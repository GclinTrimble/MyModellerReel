{
  "name": "mymodellerreel",
  "productName": "MyModellerReel",
  "version": "0.1.0",
  "description": "AI-first 3D modeller and animation sequencer of the My…Reel family. Push/pull modelling, keyframe animation, GLB native, MCP + HTTP API.",
  "main": "src/main/main.cjs",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Guillaume Clin",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "mcp": "node src/mcp/server.js",
    "mcp:config": "node scripts/mcp-config.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "three": "0.187.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mymodellerreel.app",
    "productName": "MyModellerReel",
    "files": [
      "src/**",
      "plugins/**",
      "resources/**",
      "node_modules/three/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    }
  }
}
