{
  "name": "mymodellerreel",
  "productName": "MyModellerReel",
  "version": "0.20.0",
  "description": "AI-first 3D modeller and animation sequencer of the My…Reel family. Push/pull modelling, keyframe animation, GLB native, MCP + HTTP API.",
  "main": "src/main/main.cjs",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Guillaume Clin",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "mcp": "node src/mcp/server.js",
    "mcp:config": "node scripts/mcp-config.js",
    "dist": "node scripts/check-suite-config.mjs && electron-builder --publish never --win",
    "e2e": "node --test tests/e2e/*.e2e.js",
    "eval": "node scripts/eval.mjs"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@kninnug/constrainautor": "^4.1.0",
    "@phosphor-icons/web": "^2.1.2",
    "cannon-es": "^0.20.0",
    "delaunator": "^5.1.0",
    "draco3dgltf": "^1.5.9",
    "electron-updater": "6.8.11",
    "geotiff": "3.0.5",
    "gifenc": "^1.0.3",
    "koffi": "^3.3.5",
    "mediabunny": "^1.65.2",
    "meshoptimizer": "^1.3.0",
    "pdfjs-dist": "6.4.299",
    "three": "0.187.0",
    "three-bvh-csg": "^0.0.18",
    "three-gpu-pathtracer": "^0.0.28",
    "three-mesh-bvh": "^0.9.18",
    "web-ifc": "0.0.78"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1"
  },
  "build": {
    "appId": "com.mymodellerreel.app",
    "productName": "MyModellerReel",
    "files": [
      "src/**",
      "plugins/**",
      "resources/**",
      "node_modules/three/**",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm"
      },
      "package.json",
      "docs/how-to/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "GclinTrimble",
        "repo": "MyModellerReel"
      }
    ]
  }
}
